  "cases": [
    {
      "case": "initialize",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-03-26"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-03-26",
          "capabilities": {
            "tools": {}
          },
          "serverInfo": {
            "name": "pilotdeck-funasr-local",
            "version": "0.2.0"
          },
          "instructions": "Use transcribe_audio only with an audio path inside the active PilotDeck project."
        }
      }
    },
    {
      "case": "tools-list",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/list"
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "tools": [
            {
              "name": "transcribe_audio",
              "description": "Transcribe a project-local audio file with the local FunASR SenseVoice runtime. Returns transcript text and timestamped segments.",
              "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "audio_path"
                ],
                "properties": {
                  "audio_path": {
                    "type": "string",
                    "description": "Absolute or project-relative path to an audio file inside the current project."
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "auto"
                    ],
                    "default": "auto",
                    "description": "SenseVoice local CLI detects language automatically."
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "case": "success",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "transcribe_audio",
          "arguments": {
            "audio_path": "audio.wav"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "hello world\n\nTimestamped segments:\n[1.250 - 2.500] hello world"
            }
          ],
          "structuredContent": {
            "text": "hello world",
            "segments": [
              {
                "start": 1.25,
                "end": 2.5,
                "text": "hello world"
              }
            ]
          }
        }
      }
    },
    {
      "case": "language-before-path",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "transcribe_audio",
          "arguments": {
            "language": null
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "language only supports \"auto\" for the local SenseVoice runtime."
            }
          ],
          "isError": true
        }
      }
    },
    {
      "case": "escape",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "transcribe_audio",
          "arguments": {
            "audio_path": "escape.wav"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "audio_path must resolve inside the current project root"
            }
          ],
          "isError": true
        }
      }
    },
    {
      "case": "missing-file",
      "request": {
