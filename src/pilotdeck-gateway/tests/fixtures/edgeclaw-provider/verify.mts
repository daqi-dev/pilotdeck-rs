import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {dirname,join,resolve} from 'node:path';
import {fileURLToPath} from 'node:url';
import {bindBaseline} from '../_shared/generator_guard.mjs';
import {sourceClosureSha256} from '../../baseline_source_guard.mjs';
import {SOURCES,collect} from './observe.mts';
assert.ok(process.env.PDRS_BASELINE,'#777 baseline required');
assert.ok(process.argv[2],'#777 Rust observations required');
const baseline=resolve(process.env.PDRS_BASELINE);
const oracle=JSON.parse(readFileSync(join(dirname(fileURLToPath(import.meta.url)),'oracle.json'),'utf8'));
const {gitExecutable}=bindBaseline({baseline,commit:oracle.sourceCommit});
assert.deepEqual(sourceClosureSha256(baseline,oracle.sourceCommit,gitExecutable,SOURCES),oracle.sourceSha256,'#777 source closure');
const fresh=await collect(baseline), rust=JSON.parse(readFileSync(process.argv[2],'utf8'));
assert.deepEqual(fresh.scenarios,oracle.scenarios,'#777 fresh TS matrix');
assert.deepEqual(fresh.realServiceAbort,oracle.realServiceAbort,'#777 fresh real service abort');
assert.deepEqual(fresh.realServiceClose,oracle.realServiceClose,'#777 fresh real service close');
assert.deepEqual(rust,fresh,'#777 Rust versus real TS provider');
console.log(`Node ${process.version}; ${fresh.scenarios.length} provider cells + real service abort match Rust`);
