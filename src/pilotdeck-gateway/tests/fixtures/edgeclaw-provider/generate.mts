import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {mkdirSync,writeFileSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {bindBaseline} from '../_shared/generator_guard.mjs';
import {sourceClosureSha256} from '../../baseline_source_guard.mjs';
import {ENTRY,SOURCES,NOW,RANDOM,collect} from './observe.mts';
assert.ok(process.env.PDRS_BASELINE,'#777 PDRS_BASELINE is required');
assert.ok(process.argv[2],'#777 output directory is required');
assert.equal(process.version,'v22.22.0','#777 exact Node baseline');
const baseline=resolve(process.env.PDRS_BASELINE);
const commit='cc7c4e653b15c8b2cec7bcf2d15d41d69396ae85';
const {sourceCommit,gitExecutable}=bindBaseline({baseline,commit});
const sourceSha256=sourceClosureSha256(baseline,commit,gitExecutable,SOURCES);
const observed=await collect(baseline);
assert.equal(observed.scenarios.length,41,'#777 full M20 denominator');
const oracle={sourceCommit,sourceSha256,nodeVersion:process.version,entry:ENTRY,now:NOW,random:RANDOM,...observed};
const bytes=JSON.stringify(oracle,null,2)+'\n';
const out=resolve(process.argv[2]);mkdirSync(out,{recursive:true});
writeFileSync(join(out,'oracle.json'),bytes,{flag:'wx'});
console.log(`Node ${process.version}; sha256 ${createHash('sha256').update(bytes).digest('hex')}; ${observed.scenarios.length} provider cells + real service abort`);
for(const cell of observed.scenarios) console.log(JSON.stringify(cell));
console.log(JSON.stringify({realServiceAbort:observed.realServiceAbort}));
console.log(JSON.stringify({realServiceClose:observed.realServiceClose}));
