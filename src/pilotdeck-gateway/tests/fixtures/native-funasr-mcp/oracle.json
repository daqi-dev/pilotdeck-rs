  "normalization": "Only absolute collector command paths become <NODE>, <BASELINE>, <OUT>; protocol requests/responses, stderr and exit codes are unchanged. Raw capture is retained separately.",
  "declarations": {
    "funasr": {
      "funasr": {
        "command": "__PILOTDECK_NODE_EXECUTABLE__",
        "args": [
          "__PILOTDECK_FUNASR_MCP_ENTRYPOINT__",
          "--project-root",
          "__PILOTDECK_PROJECT_ROOT__",
          "--runtime-root",
          "__PILOTDECK_FUNASR_RUNTIME_ROOT__",
          "--install-command",
          "__PILOTDECK_FUNASR_INSTALL_COMMAND__"
        ],
        "perSession": true,
        "callTimeoutMs": 300000
      }
    },
    "browser-use": {
      "browser-use": {
        "command": "__PILOTDECK_NODE_EXECUTABLE__",
        "args": [
          "__PILOTDECK_PLAYWRIGHT_MCP_ENTRYPOINT__",
          "--browser",
          "chromium",
          "--allow-unrestricted-file-access"
        ],
        "perSession": true
      }
    }
  },
