          "serverInfo": {
            "name": "pilotdeck-funasr-local",
            "version": "0.2.0"
          },
          "instructions": "Use transcribe_audio only with an audio path inside the active PilotDeck project."
        }
      },
      "stderr": "",
      "exitCode": 0
    },
