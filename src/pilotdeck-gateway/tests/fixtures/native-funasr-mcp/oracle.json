        "<OUT>/project",
        "--runtime-root",
        "<OUT>/asr",
        "--install-command",
        "mock install"
      ],
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "transcribe_audio",
          "arguments": {
            "audio_path": "audio.wav"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "hello world\n\nTimestamped segments:\n[1.250 - 2.500] hello world"
