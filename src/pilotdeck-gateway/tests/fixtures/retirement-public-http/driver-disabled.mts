import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';
const [url,project,out]=process.argv.slice(2);const principal={pilotDeckUserId:'pilot-owner',tenantId:'tenant',actorUserId:'actor',agentId:'target'};const rows:any[]=[];
async function host(path:string,body:any){const requestBody=JSON.stringify(body);const response=await fetch(new URL(path,url.replace('ws://','http://')),{method:'POST',headers:{authorization:'Bearer test-token','content-type':'application/json'},body:requestBody});const bytes=new Uint8Array(await response.arrayBuffer());assert(bytes.length<8*1024*1024);const row={path,requestBody,requestBodyHex:Buffer.from(requestBody).toString('hex'),status:response.status,headers:Object.fromEntries(response.headers),body:Buffer.from(bytes).toString('utf8'),responseBodyHex:Buffer.from(bytes).toString('hex')};rows.push(row);return row;}
try{const described=await host('/api/module-host/describe',{principal});assert.equal(described.status,200);assert(!JSON.parse(described.body).operations.includes('list_general_skills'),described.body);assert.equal(JSON.parse(described.body).operations.length,5);const refused=await host('/api/module-host/call',{principal,operation:'list_general_skills',input:{}});assert.equal(refused.status,409);assert.equal(JSON.parse(refused.body).code,'PILOTDECK_HOST_CAPABILITY_UNAVAILABLE');}finally{writeFileSync(out+'/result.json',JSON.stringify({rows},null,2),{flag:'wx'});}
