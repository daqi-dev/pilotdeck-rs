import assert from 'node:assert/strict';import{readFileSync,writeFileSync,appendFileSync}from'node:fs';import{pathToFileURL}from'node:url';
const[url,tokenFile,project,out,stateFile,phase]=process.argv.slice(2);assert(new URL(url).hostname==='127.0.0.1');let bytes=0;const Native=globalThis.WebSocket;function wire(direction:string,raw:string){bytes+=Buffer.byteLength(raw);assert(bytes<4*1024*1024);appendFileSync(out+'/wire.jsonl',JSON.stringify({direction,raw})+'\n');}globalThis.WebSocket=class extends Native{constructor(url:any,protocols?:any){super(url,protocols);this.addEventListener('message',e=>wire('receive',String(e.data)));}send(data:any){wire('send',String(data));super.send(data);}};
const{GatewayWsClient,RemoteGateway}=await import(pathToFileURL(process.env.PDRS_BASELINE+'/src/gateway/index.js').href);const client=new GatewayWsClient({url,token:readFileSync(tokenFile,'utf8').trim(),clientName:'web'});let state:any={};try{state=JSON.parse(readFileSync(stateFile,'utf8'))}catch{}const result:any={phase,reads:{},writes:[]};const timer=setTimeout(()=>{client.close();throw Error('cold switch phase deadline')},45000);
const seedKey='web:cold-switch-seed',rustKey='web:cold-switch-rust',finalKey='web:cold-switch-final';
async function upload(text:string){const content=Buffer.from(text);const record=await client.request('upload_create',{projectKey:project,files:[{clientFileId:'f1',name:text+'.txt',relativePath:text+'.txt',size:content.length,mimeType:'text/plain'}]});await client.request('upload_part',{uploadId:record.uploadId,clientFileId:'f1',contentBase64:content.toString('base64')});return await client.request('upload_complete',{uploadId:record.uploadId});}
async function cron(message:string,year:number){return await client.request('cron_create',{projectKey:project,message,schedule:{type:'once',runAt:year+'-01-01T00:00:00.000Z'},sessionKey:'web:cron:'+message,channelKey:'web'});}
async function verify(expected:any,key:string){const archive=await client.request('export_session_transcript',{projectKey:project,sessionKey:key});assert.deepEqual(archive,expected.archive);const history=await client.request('read_session_messages',{projectKey:project,sessionKey:key,limit:1000});assert(JSON.stringify(history).includes(expected.marker));assert(!history.stream?.active);result.reads[key]={archive,history};const tasks=await client.request('cron_list',{projectKey:project,includeHistory:true,limit:100});assert(JSON.stringify(tasks).includes(expected.cron.task.taskId));assert(JSON.stringify(tasks).includes(expected.cron.task.message));const taskRows=Array.isArray(tasks)?tasks:tasks.tasks;assert(Array.isArray(taskRows));assert.deepEqual(taskRows.find(t=>t.taskId===expected.cron.task.taskId),expected.cron.task);const uploadRecord=await client.request('upload_get',{uploadId:expected.upload.uploadId});assert.deepEqual(uploadRecord,expected.upload);result.reads[key].cron=tasks;result.reads[key].upload=uploadRecord;}
try{await client.connect();
 if(phase==='ts-seed'){const archive={schemaVersion:1,format:'portable_text_messages',title:'Before switch',messages:[{role:'user',text:'TS_SEED'},{role:'assistant',text:'TS_INITIAL'}]};await client.request('restore_session_transcript',{projectKey:project,sessionKey:seedKey,archive});state.seed={archive,marker:'TS_SEED',cron:await cron('TS_CRON',2035),upload:await upload('TS_UPLOAD')};result.writes.push('portable','cron','upload');}
 else if(phase==='rust-write'){await verify(state.seed,seedKey);const archive={schemaVersion:1,format:'portable_text_messages',title:'Native new data',messages:[{role:'user',text:'RUST_NEW_USER'},{role:'assistant',text:'RUST_NEW_ASSISTANT'}]};await client.request('restore_session_transcript',{projectKey:project,sessionKey:rustKey,archive});const events=[];for await(const event of new RemoteGateway(client).submitTurn({projectKey:project,sessionKey:rustKey,runId:'cold-switch-new-run',channelKey:'web',message:'RUST_RUNTIME_WRITE',maxTurns:2,canPrompt:false}))events.push(event);assert(events.some(e=>e.type==='turn_completed'&&e.finishReason==='completed'));assert(!events.some(e=>e.type==='error'));await client.request('close_session',{projectKey:project,sessionKey:rustKey});const exported=await client.request('export_session_transcript',{projectKey:project,sessionKey:rustKey});assert(JSON.stringify(exported).includes('RUST_RUNTIME_WRITE'));state.rust={archive:exported,marker:'RUST_RUNTIME_WRITE',cron:await cron('RUST_NEW_CRON',2036),upload:await upload('RUST_NEW_UPLOAD')};result.events=events;result.writes.push('portable','real-model-session','cron','upload');}
 else if(phase==='ts-readback'||phase==='rust-again'||phase==='rust-final-read'){await verify(state.seed,seedKey);await verify(state.rust,rustKey);if(phase==='rust-again'){const archive={schemaVersion:1,format:'portable_text_messages',messages:[{role:'user',text:'RUST_AFTER_ROLLBACK'}]};await client.request('restore_session_transcript',{projectKey:project,sessionKey:finalKey,archive});state.final=archive;result.writes.push('portable-after-rollback');}else if(phase==='rust-final-read'){const final=await client.request('export_session_transcript',{projectKey:project,sessionKey:finalKey});assert.deepEqual(final,state.final);result.reads[finalKey]={archive:final};}}
 else throw Error('unknown phase '+phase);
 if(result.writes.length)writeFileSync(stateFile,JSON.stringify(state,null,2)+'\n');result.pass=true;writeFileSync(out+'/result.json',JSON.stringify(result,null,2)+'\n');
}finally{clearTimeout(timer);client.close();}
