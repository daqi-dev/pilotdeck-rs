import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
import {mkdirSync,realpathSync,writeFileSync} from 'node:fs';
import {join,resolve} from 'node:path';
import { sourceClosureSha256 } from '../../baseline_source_guard.mjs';
import { bindBaseline } from '../_shared/generator_guard.mjs';
import {collect,ENTRY} from './observe.mts';
assert.ok(process.env.PDRS_BASELINE);assert.ok(process.argv[2]);
const base=resolve(process.env.PDRS_BASELINE),out=resolve(process.argv[2]);
const commit='cc7c4e653b15c8b2cec7bcf2d15d41d69396ae85';
const git=realpathSync(process.env.PDRS_GIT||execFileSync('which',['git'],{encoding:'utf8'}).trim());
const sourceCommit=bindBaseline({ baseline: base, commit: commit, gitExecutable: git }).provenance.ref;
const sourceSha256=sourceClosureSha256(base,commit,git,[ENTRY]);
const observed=await collect(base);
mkdirSync(out,{recursive:true});
writeFileSync(join(out,'oracle.json'),JSON.stringify({sourceCommit,sourceSha256,nodeVersion:process.version,...observed},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({node:process.version,cases:observed.cases.length,output:join(out,'oracle.json')}));
for(const c of observed.cases) console.log(JSON.stringify({name:c.spec.name,...c.expected.result}));
