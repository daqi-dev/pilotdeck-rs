 const result={coldState,baseline:'cc7c4e653b15c8b2cec7bcf2d15d41d69396ae85',environment:process.versions,sourceFiles:Object.fromEntries(await Promise.all(['src/web/server/forkSession.ts','src/web/server/replaceLastTurn.ts','src/session/replacement/NodeProjectSessionReplacementPort.ts','src/session/fork/NodeProjectSessionForkPort.ts'].map(async p=>[p,hash(await readFile(join(baseline,p)))]))),observations};await writeFile(join(out,'capture.json'),JSON.stringify(result,null,2)+'\n');
