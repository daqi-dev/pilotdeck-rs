 const {GatewayWsClient}=await import(pathToFileURL(join(baseline,'src/gateway/index.js')).href);client=new GatewayWsClient({url:a.url,token:(await readFile(a['token-file'],'utf8')).trim(),clientName:'web'});await client.connect();
