 const childEntry={type:'assistant_message',sessionId:'child',turnId:'nested-turn',sequence:1,createdAt:'2026-01-01T00:00:00.000Z',message:{role:'assistant',content:[{type:'tool_result_reference',path:join(internalTools,'owned.bin'),toolCallId:'nested',originalBytes:5,preview:'nested',hasMore:false},{type:'tool_result_reference',path:join(tools,'owned.txt'),toolCallId:'outside',originalBytes:16,preview:'outside',hasMore:false}]}};await writeFile(join(subagents,'nested.jsonl'),JSON.stringify(childEntry)+'\r\n  \r\n{bad}\r\n',{mode:0o600});
 const prompt='a'.repeat(47)+'😀';const entries=[
