  {type:'subagent_started',sessionId:sessionKey,sequence:seq+2,entryId:'lineage-subagent',turnId:'lineage-turn',createdAt:'2026-01-01T00:00:00.500Z',subagentId:'11111111-1111-4111-8111-111111111111',subagentType:'general-purpose',promptPreview:'owned',promptTruncated:false,transcriptRelativePath:safe+'/subagents/worker/nested.jsonl'},
  {type:'assistant_message',sessionId:sessionKey,sequence:seq+3,entryId:'lineage-assistant',turnId:'lineage-turn',createdAt:'2026-01-01T00:00:01.000Z',message:{role:'assistant',content:[{type:'text',text:'answer'},{type:'tool_result_reference',path:join(tools,'owned.txt'),toolCallId:'call',originalBytes:16,preview:'owned',hasMore:false},{type:'tool_result_reference',path:join(internalTools,'owned.bin'),toolCallId:'internal',originalBytes:5,preview:'binary',hasMore:false},{type:'media_reference',path:join(internalTools,'owned.bin'),mimeType:'image/png',mediaType:'image',originalBytes:5,preview:'image',hasMore:false}]}},
  {type:'turn_result',sessionId:sessionKey,sequence:seq+4,entryId:'lineage-result',turnId:'lineage-turn',createdAt:'2026-01-01T00:00:02.000Z',result:{type:'success',sessionId:sessionKey,turnId:'lineage-turn',stopReason:'completed',usage:{inputTokens:0,outputTokens:0,totalTokens:0},permissionDenials:[],turns:1,startedAt:'2026-01-01T00:00:00.000Z',completedAt:'2026-01-01T00:00:02.000Z'}},
 ];await appendFile(source,entries.map(e=>JSON.stringify(e)+'\n').join(''));
 for(const fromEntryId of ['lineage-input','lineage-assistant']){const value=await app.gateway.forkSession({projectKey:project,sessionKey,fromEntryId});const targets=await walk(home);const target=targets.find(p=>p.endsWith('.jsonl')&&basename(p)===value.newSessionKey.replace(/[^a-zA-Z0-9._-]/g,'_')+'.jsonl');let found:string|undefined=target;if(!found){for(const p of targets){if(p.endsWith('.jsonl')&&(await readFile(p,'utf8')).includes(JSON.stringify(value.newSessionKey))){found=p;break;}}}assert(found);const raw=await readFile(found,'utf8');const targetDir=join(dirname(found),basename(found,'.jsonl'));const auxiliaryFiles=[];for(const p of (await walk(targetDir)).sort()){const bytes=await readFile(p);auxiliaryFiles.push({relativePath:p.slice(targetDir.length+1),mode:(await stat(p)).mode&0o777,bytesBase64:bytes.toString('base64'),sha256:hash(bytes),...(p.endsWith('.jsonl')?{rawText:bytes.toString('utf8')}:{} )});}observations.push({case:'fork',fromEntryId,value,entries:raw.trim().split('\n').map(JSON.parse),auxiliaryFiles});}
