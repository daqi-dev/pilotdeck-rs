import assert from 'node:assert/strict';import{readFileSync,writeFileSync,appendFileSync}from'node:fs';import{pathToFileURL}from'node:url';
const[url,tokenFile,inputFile,out]=process.argv.slice(2);assert(new URL(url).hostname==='127.0.0.1');const input=JSON.parse(readFileSync(inputFile,'utf8'));let bytes=0;const Native=globalThis.WebSocket;function wire(direction:string,raw:string){bytes+=Buffer.byteLength(raw);assert(bytes<2*1024*1024);appendFileSync(out+'/upload-wire.jsonl',JSON.stringify({direction,raw})+'\n');}globalThis.WebSocket=class extends Native{constructor(url:any,protocols?:any){super(url,protocols);this.addEventListener('message',e=>wire('receive',String(e.data)));}send(data:any){wire('send',String(data));super.send(data);}};
const{GatewayWsClient,RemoteGateway}=await import(pathToFileURL(process.env.PDRS_BASELINE+'/src/gateway/index.js').href);const client=new GatewayWsClient({url,token:readFileSync(tokenFile,'utf8').trim(),clientName:'web'});const events=[];const timer=setTimeout(()=>{client.close();throw Error('upload turn diagnostic deadline')},20000);try{await client.connect();for await(const event of new RemoteGateway(client).submitTurn(input))events.push(event);assert(events.some(e=>e.type==='assistant_text_delta'&&e.text==='native stream text'));assert(events.some(e=>e.type==='turn_completed'&&e.finishReason==='completed'));assert(!events.some(e=>e.type==='error'),JSON.stringify(events));writeFileSync(out+'/upload-result.json',JSON.stringify({events,pass:true},null,2)+'\n');}finally{clearTimeout(timer);client.close();}
