import assert from 'node:assert/strict';import{execFileSync}from'node:child_process';import{mkdir,writeFile}from'node:fs/promises';import{join,resolve}from'node:path';import{pathToFileURL}from'node:url';const root=resolve(process.env.PDRS_BASELINE||'');const src='src/tool/dialog/FormDialogSchema.ts';const verify=()=>{assert.equal(execFileSync('git',['-C',root,'rev-parse','HEAD'],{encoding:'utf8'}).trim(),'cc7c4e653b15c8b2cec7bcf2d15d41d69396ae85');assert.equal(execFileSync('git',['-C',root,'hash-object',src],{encoding:'utf8'}).trim(),execFileSync('git',['-C',root,'rev-parse',`HEAD:${src}`],{encoding:'utf8'}).trim());};verify();assert.equal(process.version,'v22.22.0');const out=process.argv[2];assert.ok(out?.startsWith('/private/tmp/'));await mkdir(out,{recursive:false});const m=await import(pathToFileURL(join(root,src)).href);const D='https://json-schema.org/draft/2020-12/schema';
